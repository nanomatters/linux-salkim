pkgname = linux-salkim
	pkgdesc = The Linux Salkim kernel with AMDGPU and ntsync IOCP improvements kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE

pkgname = linux-salkim-headers
	pkgdesc = Headers and scripts for building modules for the Linux Salkim kernel with AMDGPU and ntsync IOCP improvements kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	depends = linux-salkim
	depends = clang
	depends = llvm
	depends = lld
	provides = LINUX-HEADERS
