### BUILD OPTIONS
# Set yes/no options or select one of the documented values below.

### Tweak kernel options prior to a build via nconfig
: "${_makenconfig:=no}"

### Tweak kernel options prior to a build via xconfig
: "${_makexconfig:=no}"

# Use a modprobed-db module list to reduce build time.
: "${_localmodcfg:=no}"

# Path to the list of used modules
: "${_localmodcfg_path:="$XDG_DATA_HOME/modprobed-db/modprobed.db"}"
# Use the current kernel's .config file
# Enabling this option will use the .config of the RUNNING kernel rather than
# the bundled config. Useful when the package gets updated and you already went
# through the trouble of customizing your config options.  NOT recommended when
# a new kernel is released, but again, convenient for package bumps.
: "${_use_current:=no}"

### Set performance governor as default
: "${_per_gov:=no}"

### Use BBR congestion control by default
: "${_tcp_bbr:=no}"

### Running with a 1000Hz, 300Hz, 250Hz or 100Hz tick rate
: "${_HZ_ticks:=1000}"

## Choose between periodic, idle or full
### Full tickless can give higher performances in various cases but, depending on hardware, lower consistency.
: "${_tickrate:=full}"

## Choose between full or lazy preemption
# Full: Makes all non-critical kernel code preemptible to reduce latency
# Lazy: Same as full but instead of preempting immediately it waits for signals from the scheduler
#       in an attempt to boost throughput.
: "${_preempt:=full}"

# Transparent hugepage policy: always or madvise.
: "${_hugepage:=always}"

# CPU target: native for this machine, generic for portable packages.
: "${_processor_opt:=native}"

# LTO mode: thin, thin-dist, full (Clang), or none (GCC).
: "${_use_llvm_lto:=thin}"

# Add an -lto suffix to the package name when requested.
: "${_use_lto_suffix:=no}"

# Use suffix -gcc when requested by the user
# Enabled by default to show the difference between LTO kernels and GCC kernels
: "${_use_gcc_suffix:=yes}"

# Enable Clang control-flow integrity.
: "${_use_kcfi:=no}"

# Build a debug package with non-stripped vmlinux
: "${_build_debug:=no}"

_is_lto_kernel() {
    [[ "$_use_llvm_lto" = "thin" || "$_use_llvm_lto" = "full"  || "$_use_llvm_lto" = "thin-dist" ]]
}

if _is_lto_kernel && [ "$_use_lto_suffix" = "yes"  ]; then
    _pkgsuffix="salkim-lto"
elif ! _is_lto_kernel && [ "$_use_gcc_suffix" = "yes" ]; then
    _pkgsuffix="salkim-gcc"
else
    _pkgsuffix="salkim"
fi

pkgbase="linux-$_pkgsuffix"
_major=7.3
pkgver=7.3
pkgrel=8
_srcname=linux-${pkgver}
pkgdesc='Linux Salkim kernel with AMDGPU and ntsync IOCP improvements'
arch=('x86_64')
url="https://www.kernel.org/"
license=('GPL-2.0-only')
options=('!strip' '!debug' '!lto')
makedepends=(
  bc
  binutils
  cpio
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)

