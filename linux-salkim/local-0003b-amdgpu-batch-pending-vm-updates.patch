Subject: [PATCH] drm/amdgpu: Batch pending VM page-table updates

Batch pending mappings per BO and batch freed-range clears into SDMA
jobs, preserving existing dependencies and required TLB invalidation.
Keep CPU updates on the per-range path.

Carry dependencies across job splits and report submitted work on
partial failure. Keep unfinished mappings pending.

---
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
index 95eeaad..a000f1a 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
@@ -998,7 +998,7 @@ int amdgpu_vm_update_pdes(struct amdgpu_device *adev,
 	struct amdgpu_vm_update_params params;
 	struct amdgpu_vm_bo_base *entry, *tmp;
 	bool flush_tlb_needed = false;
-	int r, idx;
+	int r, ret, idx;
 
 	amdgpu_vm_assert_locked(vm);
 
@@ -1024,15 +1024,17 @@ int amdgpu_vm_update_pdes(struct amdgpu_device *adev,
 
 		r = amdgpu_vm_pde_update(&params, entry);
 		if (r)
-			goto error;
+			break;
 	}
 
-	r = vm->update_funcs->commit(&params, &vm->last_update);
-	if (r)
-		goto error;
+	ret = vm->update_funcs->commit(&params, &vm->last_update);
+	if (!r)
+		r = ret;
 
 	if (flush_tlb_needed)
 		atomic64_inc(&vm->tlb_seq);
+	if (r)
+		goto error;
 
 	list_for_each_entry_safe(entry, tmp, &vm->kernel.needs_update,
 				 vm_status)
@@ -1099,49 +1101,29 @@ amdgpu_vm_tlb_flush(struct amdgpu_vm_update_params *params,
 	}
 }
 
-/**
- * amdgpu_vm_update_range - update a range in the vm page table
- *
- * @adev: amdgpu_device pointer to use for commands
- * @vm: the VM to update the range
- * @immediate: immediate submission in a page fault
- * @unlocked: unlocked invalidation during MM callback
- * @flush_tlb: trigger tlb invalidation after update completed
- * @allow_override: change MTYPE for local NUMA nodes
- * @sync: fences we need to sync to
- * @start: start of mapped range
- * @last: last mapped entry
- * @flags: flags for the entries
- * @offset: offset into nodes and pages_addr
- * @vram_base: base for vram mappings
- * @res: ttm_resource to map
- * @pages_addr: DMA addresses to use for mapping
- * @fence: optional resulting fence
- *
- * Fill in the page table entries between @start and @last.
- *
- * Returns:
- * 0 for success, negative erro code for failure.
- */
-int amdgpu_vm_update_range(struct amdgpu_device *adev, struct amdgpu_vm *vm,
-			   bool immediate, bool unlocked, bool flush_tlb,
-			   bool allow_override, struct amdgpu_sync *sync,
-			   uint64_t start, uint64_t last, uint64_t flags,
-			   uint64_t offset, uint64_t vram_base,
-			   struct ttm_resource *res, dma_addr_t *pages_addr,
-			   struct dma_fence **fence)
-{
-	struct amdgpu_vm_tlb_seq_struct *tlb_cb;
+struct amdgpu_vm_update_batch {
 	struct amdgpu_vm_update_params params;
-	struct amdgpu_res_cursor cursor;
-	int r, idx;
+	struct amdgpu_vm_tlb_seq_struct *tlb_cb;
+	int idx;
+};
 
-	if (!drm_dev_enter(adev_to_drm(adev), &idx))
+static int amdgpu_vm_update_begin(struct amdgpu_vm_update_batch *batch,
+				  struct amdgpu_device *adev,
+				  struct amdgpu_vm *vm, bool immediate,
+				  bool unlocked, bool flush_tlb,
+				  bool allow_override, struct amdgpu_sync *sync)
+{
+	struct amdgpu_vm_update_params *params = &batch->params;
+	int r;
+
+	memset(batch, 0, sizeof(*batch));
+
+	if (!drm_dev_enter(adev_to_drm(adev), &batch->idx))
 		return -ENODEV;
 
-	tlb_cb = kmalloc_obj(*tlb_cb);
-	if (!tlb_cb) {
-		drm_dev_exit(idx);
+	batch->tlb_cb = kmalloc_obj(*batch->tlb_cb);
+	if (!batch->tlb_cb) {
+		drm_dev_exit(batch->idx);
 		return -ENOMEM;
 	}
 
@@ -1156,15 +1138,13 @@ int amdgpu_vm_update_range(struct amdgpu_device *adev, struct amdgpu_vm *vm,
 	 */
 	flush_tlb |= amdgpu_ip_version(adev, GC_HWIP, 0) < IP_VERSION(9, 0, 0);
 
-	memset(&params, 0, sizeof(params));
-	params.adev = adev;
-	params.vm = vm;
-	params.immediate = immediate;
-	params.pages_addr = pages_addr;
-	params.unlocked = unlocked;
-	params.needs_flush = flush_tlb;
-	params.override_pte = allow_override && adev->gmc.override_pte;
-	INIT_LIST_HEAD(&params.tlb_flush_waitlist);
+	params->adev = adev;
+	params->vm = vm;
+	params->immediate = immediate;
+	params->unlocked = unlocked;
+	params->needs_flush = flush_tlb;
+	params->override_pte = allow_override && adev->gmc.override_pte;
+	INIT_LIST_HEAD(&params->tlb_flush_waitlist);
 
 	amdgpu_vm_eviction_lock(vm);
 	if (vm->evicting) {
@@ -1180,11 +1160,30 @@ int amdgpu_vm_update_range(struct amdgpu_device *adev, struct amdgpu_vm *vm,
 		dma_fence_put(tmp);
 	}
 
-	r = vm->update_funcs->prepare(&params, sync,
+	r = vm->update_funcs->prepare(params, sync,
 				      AMDGPU_KERNEL_JOB_ID_VM_UPDATE_RANGE);
 	if (r)
 		goto error_free;
 
+	return 0;
+
+error_free:
+	kfree(batch->tlb_cb);
+	amdgpu_vm_eviction_unlock(vm);
+	drm_dev_exit(batch->idx);
+	return r;
+}
+
+static int amdgpu_vm_update_pages(struct amdgpu_vm_update_params *params,
+				  uint64_t start, uint64_t last, uint64_t flags,
+				  uint64_t offset, uint64_t vram_base,
+				  struct ttm_resource *res, dma_addr_t *pages_addr)
+{
+	struct amdgpu_device *adev = params->adev;
+	struct amdgpu_res_cursor cursor;
+	int r;
+
+	params->pages_addr = pages_addr;
 	amdgpu_res_first(pages_addr ? NULL : res, offset,
 			 (last - start + 1) * AMDGPU_GPU_PAGE_SIZE, &cursor);
 	while (cursor.remaining) {
@@ -1218,10 +1217,10 @@ int amdgpu_vm_update_range(struct amdgpu_device *adev, struct amdgpu_vm *vm,
 
 			if (!contiguous) {
 				addr = cursor.start;
-				params.pages_addr = pages_addr;
+				params->pages_addr = pages_addr;
 			} else {
 				addr = pages_addr[cursor.start >> PAGE_SHIFT];
-				params.pages_addr = NULL;
+				params->pages_addr = NULL;
 			}
 
 		} else if (flags & (AMDGPU_PTE_VALID | AMDGPU_PTE_PRT_FLAG(adev))) {
@@ -1231,32 +1230,89 @@ int amdgpu_vm_update_range(struct amdgpu_device *adev, struct amdgpu_vm *vm,
 		}
 
 		tmp = start + num_entries;
-		r = amdgpu_vm_ptes_update(&params, start, tmp, addr, flags);
+		r = amdgpu_vm_ptes_update(params, start, tmp, addr, flags);
 		if (r)
-			goto error_free;
+			return r;
 
 		amdgpu_res_next(&cursor, num_entries * AMDGPU_GPU_PAGE_SIZE);
 		start = tmp;
 	}
 
-	r = vm->update_funcs->commit(&params, fence);
+	return 0;
+}
+
+static int amdgpu_vm_update_end(struct amdgpu_vm_update_batch *batch,
+				struct dma_fence **fence)
+{
+	struct amdgpu_vm_update_params *params = &batch->params;
+	struct amdgpu_vm *vm = params->vm;
+	int r;
+
+	/* Publish any queued prefix, including when a later range failed. */
+	r = vm->update_funcs->commit(params, fence);
 	if (r)
 		goto error_free;
 
-	if (params.needs_flush) {
-		amdgpu_vm_tlb_flush(&params, fence ? *fence : NULL, tlb_cb);
-		tlb_cb = NULL;
+	if (params->needs_flush) {
+		amdgpu_vm_tlb_flush(params, fence ? *fence : NULL, batch->tlb_cb);
+		batch->tlb_cb = NULL;
 	}
 
-	amdgpu_vm_pt_free_list(adev, &params);
+	amdgpu_vm_pt_free_list(params->adev, params);
 
 error_free:
-	kfree(tlb_cb);
+	kfree(batch->tlb_cb);
 	amdgpu_vm_eviction_unlock(vm);
-	drm_dev_exit(idx);
+	drm_dev_exit(batch->idx);
 	return r;
 }
 
+/**
+ * amdgpu_vm_update_range - update a range in the vm page table
+ *
+ * @adev: amdgpu_device pointer to use for commands
+ * @vm: the VM to update the range
+ * @immediate: immediate submission in a page fault
+ * @unlocked: unlocked invalidation during MM callback
+ * @flush_tlb: trigger tlb invalidation after update completed
+ * @allow_override: change MTYPE for local NUMA nodes
+ * @sync: fences we need to sync to
+ * @start: start of mapped range
+ * @last: last mapped entry
+ * @flags: flags for the entries
+ * @offset: offset into nodes and pages_addr
+ * @vram_base: base for vram mappings
+ * @res: ttm_resource to map
+ * @pages_addr: DMA addresses to use for mapping
+ * @fence: optional resulting fence
+ *
+ * Fill in the page table entries between @start and @last.
+ *
+ * Returns:
+ * 0 for success, negative erro code for failure.
+ */
+int amdgpu_vm_update_range(struct amdgpu_device *adev, struct amdgpu_vm *vm,
+			   bool immediate, bool unlocked, bool flush_tlb,
+			   bool allow_override, struct amdgpu_sync *sync,
+			   uint64_t start, uint64_t last, uint64_t flags,
+			   uint64_t offset, uint64_t vram_base,
+			   struct ttm_resource *res, dma_addr_t *pages_addr,
+			   struct dma_fence **fence)
+{
+	struct amdgpu_vm_update_batch batch;
+	int r, ret;
+
+	r = amdgpu_vm_update_begin(&batch, adev, vm, immediate, unlocked,
+				   flush_tlb, allow_override, sync);
+	if (r)
+		return r;
+
+	r = amdgpu_vm_update_pages(&batch.params, start, last, flags, offset,
+				   vram_base, res, pages_addr);
+	ret = amdgpu_vm_update_end(&batch, fence);
+	return r ? r : ret;
+}
+
 void amdgpu_vm_get_memory(struct amdgpu_vm *vm,
 			  struct amdgpu_mem_stats stats[__AMDGPU_PL_NUM])
 {
@@ -1280,6 +1336,7 @@ void amdgpu_vm_get_memory(struct amdgpu_vm *vm,
 int amdgpu_vm_bo_update(struct amdgpu_device *adev, struct amdgpu_bo_va *bo_va,
 			bool clear)
 {
+	struct amdgpu_vm_update_batch batch;
 	struct amdgpu_bo *bo = bo_va->base.bo;
 	struct amdgpu_vm *vm = bo_va->base.vm;
 	struct amdgpu_bo_va_mapping *mapping;
@@ -1290,8 +1347,8 @@ int amdgpu_vm_bo_update(struct amdgpu_device *adev, struct amdgpu_bo_va *bo_va,
 	bool flush_tlb = clear;
 	uint64_t vram_base;
 	uint64_t flags;
-	bool uncached;
-	int r;
+	bool uncached, batching;
+	int r = 0, ret;
 
 	amdgpu_sync_create(&sync);
 	if (clear) {
@@ -1368,6 +1425,14 @@ int amdgpu_vm_bo_update(struct amdgpu_device *adev, struct amdgpu_bo_va *bo_va,
 		list_splice_init(&bo_va->valids, &bo_va->invalids);
 	}
 
+	batching = !vm->use_cpu_for_update && !list_empty(&bo_va->invalids);
+	if (batching) {
+		r = amdgpu_vm_update_begin(&batch, adev, vm, false, false,
+					   flush_tlb, !uncached, &sync);
+		if (r)
+			goto error_free;
+	}
+
 	list_for_each_entry(mapping, &bo_va->invalids, list) {
 		uint64_t update_flags = flags;
 
@@ -1385,15 +1450,29 @@ int amdgpu_vm_bo_update(struct amdgpu_device *adev, struct amdgpu_bo_va *bo_va,
 
 		trace_amdgpu_vm_bo_update(mapping);
 
-		r = amdgpu_vm_update_range(adev, vm, false, false, flush_tlb,
+		if (batching)
+			r = amdgpu_vm_update_pages(&batch.params, mapping->start,
+					   mapping->last, update_flags,
+					   mapping->offset, vram_base, mem,
+					   pages_addr);
+		else
+			r = amdgpu_vm_update_range(adev, vm, false, false, flush_tlb,
 					   !uncached, &sync, mapping->start,
 					   mapping->last, update_flags,
 					   mapping->offset, vram_base, mem,
 					   pages_addr, last_update);
 		if (r)
-			goto error_free;
+			break;
 	}
 
+	if (batching) {
+		ret = amdgpu_vm_update_end(&batch, last_update);
+		if (!r)
+			r = ret;
+	}
+	if (r)
+		goto error_free;
+
 	/* If the BO is not in its preferred location add it back to
 	 * the evicted list so that it gets validated again on the
 	 * next command submission.
@@ -1564,8 +1643,8 @@
  *
  * @adev: amdgpu_device pointer
  * @vm: requested vm
- * @fence: optional resulting fence (unchanged if no work needed to be done
- * or if an error occurred)
+ * @fence: optional fence for submitted clears, including on partial failure;
+ *         unchanged if no work was submitted
  *
  * Make sure all freed BOs are cleared in the PT.
  * PTs have to be reserved and mutex must be locked!
@@ -1578,10 +1657,13 @@ int amdgpu_vm_clear_freed(struct amdgpu_device *adev,
 			  struct amdgpu_vm *vm,
 			  struct dma_fence **fence)
 {
-	struct amdgpu_bo_va_mapping *mapping;
+	struct amdgpu_bo_va_mapping *mapping, *tmp;
+	struct amdgpu_vm_update_batch batch;
+	LIST_HEAD(cleared);
 	struct dma_fence *f = NULL;
 	struct amdgpu_sync sync;
-	int r;
+	bool batching = !vm->use_cpu_for_update;
+	int r, ret;
 
 	if (list_empty(&vm->freed))
 		return 0;
@@ -1596,21 +1678,46 @@ int amdgpu_vm_clear_freed(struct amdgpu_device *adev,
 	if (r)
 		goto error_free;
 
-	while (!list_empty(&vm->freed)) {
-		mapping = list_first_entry(&vm->freed,
-			struct amdgpu_bo_va_mapping, list);
-		list_del(&mapping->list);
+	if (batching) {
+		r = amdgpu_vm_update_begin(&batch, adev, vm, false, false,
+					   true, false, &sync);
+		if (r)
+			goto error_free;
+	}
 
-		r = amdgpu_vm_update_range(adev, vm, false, false, true, false,
+	list_for_each_entry_safe(mapping, tmp, &vm->freed, list) {
+		if (batching)
+			r = amdgpu_vm_update_pages(&batch.params, mapping->start,
+					   mapping->last, 0, 0, 0, NULL, NULL);
+		else
+			r = amdgpu_vm_update_range(adev, vm, false, false, true, false,
 					   &sync, mapping->start, mapping->last,
 					   0, 0, 0, NULL, NULL, &f);
-		amdgpu_vm_free_mapping(adev, vm, mapping, f);
-		if (r) {
-			dma_fence_put(f);
-			goto error_free;
+		if (r)
+			break;
+		if (batching) {
+			list_move_tail(&mapping->list, &cleared);
+		} else {
+			list_del(&mapping->list);
+			amdgpu_vm_free_mapping(adev, vm, mapping, f);
+		}
+	}
+
+	if (batching) {
+		ret = amdgpu_vm_update_end(&batch, &f);
+		if (ret) {
+			list_splice_init(&cleared, &vm->freed);
+		} else {
+			list_for_each_entry_safe(mapping, tmp, &cleared, list) {
+				list_del(&mapping->list);
+				amdgpu_vm_free_mapping(adev, vm, mapping, f);
+			}
 		}
+		if (!r)
+			r = ret;
 	}
 
+	/* A failed later range must not hide an already submitted prefix. */
 	if (fence && f) {
 		dma_fence_put(*fence);
 		*fence = f;
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_pt.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_pt.c
index cef4171..31d33af 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_pt.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_pt.c
@@ -369,7 +369,7 @@ int amdgpu_vm_pt_clear(struct amdgpu_device *adev, struct amdgpu_vm *vm,
 	struct amdgpu_bo *bo = &vmbo->bo;
 	uint64_t value = 0, flags = 0;
 	uint64_t addr;
-	int r, idx;
+	int r, ret, idx;
 
 	/* Figure out our place in the hierarchy */
 	if (ancestor->parent) {
@@ -419,10 +419,10 @@ int amdgpu_vm_pt_clear(struct amdgpu_device *adev, struct amdgpu_vm *vm,
 
 	r = vm->update_funcs->update(&params, vmbo, addr, 0, entries,
 				     value, flags);
-	if (r)
-		goto exit;
 
-	r = vm->update_funcs->commit(&params, &vm->last_update);
+	ret = vm->update_funcs->commit(&params, &vm->last_update);
+	if (!r)
+		r = ret;
 exit:
 	drm_dev_exit(idx);
 	return r;
@@ -672,7 +672,7 @@ static void amdgpu_vm_pte_update_noretry_flags(struct amdgpu_device *adev,
  *
  * Make sure to set the right flags for the PTEs at the desired level.
  */
-static void amdgpu_vm_pte_update_flags(struct amdgpu_vm_update_params *params,
+static int amdgpu_vm_pte_update_flags(struct amdgpu_vm_update_params *params,
 				       struct amdgpu_bo_vm *pt,
 				       unsigned int level,
 				       uint64_t pe, uint64_t addr,
@@ -706,7 +706,7 @@ static void amdgpu_vm_pte_update_flags(struct amdgpu_vm_update_params *params,
 	if (level == AMDGPU_VM_PTB)
 		amdgpu_vm_pte_update_noretry_flags(adev, &flags);
 
-	params->vm->update_funcs->update(params, pt, pe, addr, count, incr,
+	return params->vm->update_funcs->update(params, pt, pe, addr, count, incr,
 					 flags);
 }
 
@@ -896,9 +896,11 @@ int amdgpu_vm_ptes_update(struct amdgpu_vm_update_params *params,
 						    upd_flags,
 						    vm->task_info ? vm->task_info->tgid : 0,
 						    vm->immediate.fence_context);
-			amdgpu_vm_pte_update_flags(params, to_amdgpu_bo_vm(pt),
+			r = amdgpu_vm_pte_update_flags(params, to_amdgpu_bo_vm(pt),
 						   cursor.level, pe_start, dst,
 						   nptes, incr, upd_flags);
+			if (r)
+				return r;
 
 			pe_start += nptes * 8;
 			dst += nptes * incr;
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_sdma.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_sdma.c
index 652266e..cca19a2 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_sdma.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_sdma.c
@@ -113,7 +113,10 @@ static int amdgpu_vm_sdma_commit(struct amdgpu_vm_update_params *p,
 	ring = container_of(p->vm->delayed.rq->sched, struct amdgpu_ring,
 			    sched);
 
-	WARN_ON(ib->length_dw == 0);
+	if (!ib->length_dw) {
+		amdgpu_job_free(p->job);
+		return 0;
+	}
 	amdgpu_ring_pad_ib(ring, ib);
 
 	if (p->needs_flush)
@@ -245,15 +248,32 @@ static int amdgpu_vm_sdma_update(struct amdgpu_vm_update_params *p,
 		ndw -= p->job->ibs->length_dw;
 
 		if (ndw < 32) {
-			r = amdgpu_vm_sdma_commit(p, NULL);
-			if (r)
-				return r;
+			struct amdgpu_vm_update_params next = *p;
+			unsigned long index;
 
-			r = amdgpu_vm_sdma_alloc_job(p, count,
+			/* Keep the current job available for error-path completion. */
+			r = amdgpu_vm_sdma_alloc_job(&next, count,
 						     AMDGPU_KERNEL_JOB_ID_VM_UPDATE);
 			if (r)
 				return r;
 
+			xa_for_each(&p->job->base.dependencies, index, fence) {
+				r = drm_sched_job_add_dependency(&next.job->base,
+							 dma_fence_get(fence));
+				if (r) {
+					amdgpu_job_free(next.job);
+					return r;
+				}
+			}
+
+			r = amdgpu_vm_sdma_commit(p, NULL);
+			if (r) {
+				amdgpu_job_free(next.job);
+				return r;
+			}
+			p->job = next.job;
+			p->num_dw_left = next.num_dw_left;
+
 			/* The estimate above describes the job which was just
 			 * submitted, take the budget of the newly allocated one.
 			 */
